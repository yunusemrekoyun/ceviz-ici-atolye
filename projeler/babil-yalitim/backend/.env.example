PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/dbname
JWT_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASS_HASH=
ACCESS_TOKEN_EXPIRES_IN=1h
COOKIE_DOMAIN=
CROSS_SITE_COOKIES=0
FRONTEND_ORIGIN=https://your-frontend.example
EXTRA_ALLOWED_ORIGINS=https://staging.example,https://preview.example
BASE_URL=https://your-backend.example
VERCEL_PREVIEW_ALLOWED=1

MEDIA_ROOT=./media
MEDIA_PUBLIC_PATH=/media
MEDIA_BASE_URL=https://your-backend.example/media
MEDIA_IMAGE_VARIANT_WIDTHS=480,960,1600
MEDIA_IMAGE_VARIANT_QUALITY=82
MEDIA_VIDEO_PREVIEW_MAX_EDGE=960
MEDIA_VIDEO_DETAIL_MAX_EDGE=1440
MEDIA_VIDEO_PREVIEW_CRF=32
MEDIA_VIDEO_DETAIL_CRF=23
MEDIA_VIDEO_PREVIEW_WITH_AUDIO=0
MEDIA_VIDEO_AUDIO_BITRATE=128k
# Servis edilen ana dosyanin sinirlari. Ham yukleme bunlarin ustundeyse
# yeniden kodlanir ve orijinali <ad>.original.<uzanti> olarak arsivlenir.
MEDIA_VIDEO_WEB_MAX_EDGE=1920
MEDIA_VIDEO_WEB_CRF=28
MEDIA_VIDEO_MAX_FPS=30
# Cozunurluk ve fps uygun olsa bile bu bitrate'i asan videolar yeniden kodlanir.
MEDIA_VIDEO_WEB_MAX_BITRATE_MBPS=2.5
# Mutlak boyut kurali (MB). 0 = kapali. Uzun ama verimli kodlanmis videolarda
# yeniden kodlama kazandirmadigi icin varsayilan kapalidir.
MEDIA_VIDEO_WEB_MAX_MB=0
# CRF ile kazanc saglanamayan kaynaklarda hedef bitrate katsayisi.
MEDIA_VIDEO_BITRATE_FACTOR=0.04
MEDIA_IMAGE_WEB_MAX_WIDTH=2560
MEDIA_IMAGE_WEB_QUALITY=90
MEDIA_BLOGS_FOLDER=blogs
MEDIA_JOURNALS_FOLDER=journals
MEDIA_PROJECTS_FOLDER=projects
MEDIA_SERVICES_FOLDER=services

LIKE_SALT=change-me
COMMENT_EMAIL_SALT=change-me
MAX_VIDEO_SIZE_MB=200
VERTICAL_MIN_RATIO=1.5
ANALYTICS_RETENTION_DAYS=180

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_TO_EMAIL=your-gmail@gmail.com
CONTACT_FROM_EMAIL=your-gmail@gmail.com
