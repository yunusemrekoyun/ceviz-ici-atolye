[Unit]
Description=Oldscks media processing worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=oldscks
Group=oldscks
WorkingDirectory=/srv/oldscks/app/backend
EnvironmentFile=/srv/oldscks/app/backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node media-worker.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=900
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/oldscks/media /srv/oldscks/backup

Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
