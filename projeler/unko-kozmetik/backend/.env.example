# Sunucu portu (macOS'ta 5000 portunu AirPlay Receiver kullandığı için 5001)
PORT=5001

# MongoDB bağlantısı (docker compose ile açılan yerel veritabanı)
MONGO_URI=mongodb://127.0.0.1:27017/unko-kozmetik

# JWT anahtarları — production'da uzun ve rastgele değerler kullanın
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=
REFRESH_SECRET=

# Frontend adresi (CORS ve ödeme dönüş adresleri). Birden fazlaysa virgülle ayırın;
# ödeme dönüşünde ilki kullanılır.
CLIENT_DOMAIN=http://localhost:5173

# Stripe (opsiyonel). Boş bırakılırsa geliştirme ortamında ödeme TEST modunda çalışır.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# npm run seed ile oluşturulan admin hesabı
SEED_ADMIN_EMAIL=admin@unkokozmetik.com
SEED_ADMIN_PASSWORD=admin123
